{
  "installCommand": "npm install --omit=dev",
  "headers": [
    {
      "source": "/gate.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}